# CIVICPULSE Environment Variables

# Backend Port
PORT=5000

# MongoDB Connection String (Optional: falls back to embedded mongodb-memory-server if left blank or offline)
MONGODB_URI=mongodb://127.0.0.1:27017/civicpulse

# JWT Secret Key
JWT_SECRET=civicpulse_super_secret_jwt_key_2026

# AI LLM Service API Keys (Optional: deterministic intelligent fallback engine active if blank)
GEMINI_API_KEY=
OPENAI_API_KEY=
